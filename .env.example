# LKML Analyzer 环境变量配置模板
# 复制此文件为 .env 并填写真实值

# MySQL
MYSQL_ROOT_PASSWORD=请填写MySQL root密码
MYSQL_DATABASE=lkml_analyze
MYSQL_USER=请填写MySQL普通用户名
MYSQL_PASSWORD=请填写MySQL普通用户密码

# RabbitMQ
SPRING_RABBITMQ_USERNAME=填写 rabbitmq 用户名
SPRING_RABBITMQ_PASSWORD=填写 rabbitmq 密码

# API Keys
# Gmail 邮箱授权码（用于 SMTP 发送）
API_KEY_EMAIL=请填写邮箱地址
API_KEY_EMAIL_VALUE=请填写邮箱SMTP授权码

# DeepSeek API Keys
API_KEY_DEEPSEEK_ANALYZER=deepseek-lkml-analyzer
API_KEY_DEEPSEEK_ANALYZER_VALUE=请填写DeepSeek API Key

API_KEY_DEEPSEEK_CHAT=deepseek-analyzer-report-chat
API_KEY_DEEPSEEK_CHAT_VALUE=请填写DeepSeek API Key

API_KEY_DEEPSEEK_ABSTRACT=deepseek-analyzer-report-chat-abstract
API_KEY_DEEPSEEK_ABSTRACT_VALUE=请填写DeepSeek API Key